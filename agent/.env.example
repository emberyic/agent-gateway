# 终端里复制成 .env 再填值，命令：cp .env.example .env

# —— 主模型（DeepSeek，OpenAI 兼容协议）——
DEEPSEEK_API_KEY=sk-在这里填你的key
# 你要使用的模型
AGENT_MODEL=deepseek-chat
# API 请求地址（官方默认，除非用代理否则不用改）
# DeepSeek 默认：https://api.deepseek.com
# OpenAI 默认：https://api.openai.com/v1
AGENT_BASE_URL=https://api.deepseek.com

# —— 备用模型（降级）——
# 三项都填齐才启用：主模型失败（超时/网络/认证/5xx）时用它重试同一次模型调用。
# 可以填同一个 provider 的另一个模型，也可以填另一家（任何 OpenAI 兼容端点）。
# AGENT_FALLBACK_MODEL=deepseek-chat
# AGENT_FALLBACK_BASE_URL=https://api.deepseek.com
# AGENT_FALLBACK_API_KEY=sk-备用key

# —— 超时与重试 ——
AGENT_LLM_TIMEOUT_SECONDS=60    # 单次 HTTP 请求超时（不是整轮对话总时限）
AGENT_LLM_MAX_RETRIES=1         # SDK 层重试（429/5xx 这类瞬时错误）

# —— 历史裁剪（滑动窗口）——
AGENT_HISTORY_MAX_ROUNDS=8      # 喂给模型的最大轮数（一轮 = 一条 Human + 它的全部应答）
AGENT_HISTORY_MAX_CHARS=24000   # 字符预算兜底（近似 token）
AGENT_HISTORY_KEEP_FIRST_HUMAN=true    # 首条 Human 被裁掉时补一条「仅供背景参考」的说明
AGENT_HISTORY_REPAIR_TOOL_CALLS=true   # 入模前修复悬空/损坏的 tool_calls

# —— 流式输出 ——
AGENT_STREAM_FLUSH_CHARS=200        # 缓冲区超过这么多字就发一帧
AGENT_STREAM_FLUSH_PAUSE_SECONDS=0.15  # 或者攒够这么久也发（时间维度兜底）
AGENT_STREAM_FLUSH_PUNCT=。！？!?；;   # 断句符（故意不含换行：markdown 换行太频繁）
AGENT_HEARTBEAT_SECONDS=10           # 空闲多久发一个 ": ping" 心跳保活

# —— 工具 ——
# 和风天气专属 API Host (前往 https://console.qweather.com/setting 查看)
QWEATHER_HOST=
# api key请在项目管理处查看
QWEATHER_API_KEY=

# —— 服务 ——
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
